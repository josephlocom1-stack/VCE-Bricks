{
  "expo": {
    "name": "Numbit",
    "slug": "numbit",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.josephlocom.numbit"
    },
    "android": {
      "package": "com.josephlocom.numbit",
      "versionCode": 1,
      "permissions": ["android.permission.VIBRATE"],
      "predictiveBackGestureEnabled": false
    },
    "plugins": ["expo-sqlite"]
  }
}
